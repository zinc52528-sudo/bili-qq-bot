{
  "target_session": {
    "description": "日报推送目标会话（platform:MessageType:session_id）",
    "type": "string",
    "hint": "默认推送到 QQ 单聊 943867461",
    "default": "default:FriendMessage:943867461"
  },
  "cron_expression": {
    "description": "推送时间（crontab）",
    "type": "string",
    "hint": "例如 0 8 * * * 表示每天 08:00",
    "default": "0 8 * * *"
  },
  "default_city": {
    "description": "默认城市",
    "type": "string",
    "default": "上海"
  },
  "interests": {
    "description": "关注的游戏（逗号分隔）",
    "type": "string",
    "hint": "用于日报中的游戏动态板块",
    "default": "英雄联盟,LPL"
  },
  "api_host": {
    "description": "和风 API Host",
    "type": "string",
    "default": "mb33jrhhn3.re.qweatherapi.com"
  },
  "auth_mode": {
    "description": "和风认证方式",
    "type": "string",
    "options": ["jwt", "api_key"],
    "default": "jwt"
  },
  "api_key": {
    "description": "和风 API Key（auth_mode=api_key 时使用）",
    "type": "string",
    "default": "6fa50fc9e5454606ad22b6eceb0123c7"
  },
  "credential_id": {
    "description": "和风 JWT 凭据 ID",
    "type": "string",
    "default": "KAB6RJBC2M"
  },
  "project_id": {
    "description": "和风项目 ID（JWT sub）",
    "type": "string",
    "default": "4K85YKA8KV"
  },
  "private_key_path": {
    "description": "和风 Ed25519 私钥路径",
    "type": "string",
    "default": "/AstrBot/data/qweather_private.pem"
  },
  "exa_key": {
    "description": "Exa 搜索 API Key",
    "type": "string",
    "hint": "用于赛事/游戏动态搜索",
    "default": "14dccd9b-eefd-44a6-b44f-720e7c07e094"
  },
  "bili_cookie_path": {
    "description": "B 站 Cookie 文件路径（复用 bilivideo 插件登录态）",
    "type": "string",
    "default": "/AstrBot/data/plugin_data/astrbot_plugin_bilivideo/bili_cookies.json"
  },
  "bili_esports_uids": {
    "description": "赛事板块关注的 B 站账号 UID（逗号分隔）",
    "type": "string",
    "hint": "例如 50329118=哔哩哔哩英雄联盟赛事",
    "default": "50329118"
  },
  "bili_extra_uids": {
    "description": "游戏动态板块额外关注的 B 站账号 UID（逗号分隔，可留空自动读取订阅）",
    "type": "string",
    "default": ""
  }
}
